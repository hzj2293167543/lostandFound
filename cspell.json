{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "files": ["**/*.{js,ts,jsx,tsx,vue,md,json,yml,yaml,txt}"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.git/**",
    "**/*.min.js",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "*.{png,jpg,svg,woff,woff2,eot,ttf}"
  ],
  "dictionaries": ["typescript", "html", "node", "project-words"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": ".cspell/project-words.txt",
      "addWords": true
    }
  ],
  "words": ["revalidator", "DAYOFWEEK", "wordcloud"],
  "ignoreWords": [],
  "import": []
}
