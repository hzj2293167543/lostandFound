**/.env
**/.env.local
**/.env.*.local
**/.env.*

# 日志文件
**/logs/
**/*.log
**/lerna-debug.log*

# 运行时数据
*.pid
.DS_Store
Thumbs.db
Desktop.ini
[Dd]esktop.ini

